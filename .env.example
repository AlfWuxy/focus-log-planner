# 只读 Notion 集成。请复制为 .env.local，不要提交真实 token。
NOTION_TOKEN=
NOTION_DAILY_DATA_SOURCE_ID=
NOTION_NOTES_DATA_SOURCE_ID=

# 本地浏览器与只读 API 的独立配对密钥，至少 32 个字符。不要复用 Notion token。
FOCUS_LOG_LOCAL_TOKEN=

# 下面是可选字段映射，右侧填写 Notion 数据源中的实际属性名。
NOTION_DAILY_TITLE_FIELD=Day
NOTION_DAILY_DATE_FIELD=Date
NOTION_DAILY_BIG_THREE_FIELD=Big 3
NOTION_DAILY_FOCUS_HOURS_FIELD=Focus Hours
NOTION_DAILY_RESULT_FIELD=Result
NOTION_DAILY_UNFINISHED_FIELD=Unfinished?
NOTION_DAILY_REASON_FIELD=Reason
NOTION_DAILY_NEXT_ACTION_FIELD=Next Action

# 可选兼容字段，仅在旧数据源仍使用这些属性时调整。
NOTION_DAILY_FOCUS_FIELD=Focus
NOTION_DAILY_PLAN_FIELD=Plan
NOTION_DAILY_PROGRESS_FIELD=Progress
NOTION_DAILY_REFLECTION_FIELD=Reflection
NOTION_DAILY_STATUS_FIELD=Status
NOTION_DAILY_TAGS_FIELD=Tags
NOTION_DAILY_URL_FIELD=URL

NOTION_NOTES_TITLE_FIELD=Name
NOTION_NOTES_DATE_FIELD=日期
NOTION_NOTES_CONTENT_FIELD=Content
NOTION_NOTES_STATUS_FIELD=Status
NOTION_NOTES_TAGS_FIELD=Tags
NOTION_NOTES_URL_FIELD=URL

# 可选：本地 API 与 Vite 代理会共同读取此端口。
PORT=8787
